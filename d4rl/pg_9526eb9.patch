--- a/evaluation.py
+++ b/evaluation.py
@@ -12,7 +12,9 @@ def evaluate(planner, policy, critic, planner_model, policy_model, rng, config,
     progress = tqdm(range(config.num_episodes))
     
     episode_rewards = []
