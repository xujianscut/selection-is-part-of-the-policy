         # for maze2d
@@ -30,7 +32,16 @@ def evaluate(planner, policy, critic, planner_model, policy_model, rng, config,
             
             # MCSS
             value = critic.eval_forward(traj)
-            idx = jnp.argmax(value)
+            rule = getattr(config, "select_rule", "argmax")
+            if rule == "argmax":
+                idx = jnp.argmax(value)
+            elif rule == "soft":  # sample prop. to exp(z / T), z = per-step standardized critic value
+                v = value.reshape(-1)
+                z = (v - v.mean()) / (v.std() + 1e-6)
+                key3, rng = jax.random.split(rng)
+                idx = jax.random.categorical(key3, z / config.soft_temp)
+            else:
+                raise ValueError(rule)
             traj = traj[idx]
             traj = jnp.expand_dims(traj, axis=0)
 
